# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-6

# ── Database ───────────────────────────────────────────────────────────────────
# Set DB_TYPE to "oracle" for production or "sqlite" for local dev/testing
DB_TYPE=sqlite
SQLITE_PATH=telco_dev.db

# Oracle (only needed when DB_TYPE=oracle)
ORA_USER=telco_agent
ORA_PASSWORD=your_oracle_password
ORA_DSN=localhost:1521/XEPDB1

# ── App ────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── API auth ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed values for the X-API-Key request header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The /health endpoint is public; everything else requires a valid key.
# If empty/unset, protected endpoints return 503 (fail closed).
TELCO_AGENT_API_KEYS=dev-local-only-not-secret,another-key-for-rotation-demo

# ── Container persistence paths (used inside Docker; ignored locally) ──────────
# When running via docker-compose these point at the mounted /data volume.
# Leave unset for local non-container runs to use the in-repo defaults.
# SQLITE_PATH=/data/telco_dev.db
# RAG_CHROMA_PATH=/data/chromadb
# AGENT_MEMORY_PATH=/data/agent_memory

# ── Container entrypoint behavior (compose-only) ───────────────────────────────
# AUTO_SEED=true     # seed SQLite on first boot if DB is missing
# AUTO_INGEST=true   # ensure runbooks are in ChromaDB on boot
